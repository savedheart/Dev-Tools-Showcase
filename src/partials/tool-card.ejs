<article class="tool-card" itemscope itemtype="https://schema.org/SoftwareApplication">
    <h3 class="tool-card__title" itemprop="name">
        <%= title %>
    </h3>

    <p class="tool-card__description" itemprop="description">
        <%= description %>
    </p>

    <a class="tool-card__link button button--primary" href="<%= link %>" itemprop="url" data-i18n="tool.open">
        Open
    </a>
</article>